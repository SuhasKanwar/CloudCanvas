{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudcanvas.dev/schemas/graph-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": ["string", "null"], "maxLength": 2000 },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "config"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "enum": ["EC2_INSTANCE", "ECR_REPOSITORY", "S3_BUCKET", "IAM_ROLE", "LAMBDA_FUNCTION", "DYNAMODB_TABLE", "SQS_QUEUE", "SNS_TOPIC"] },
        "label": { "type": ["string", "null"], "maxLength": 120 },
        "positionX": { "type": "number", "default": 0 },
        "positionY": { "type": "number", "default": 0 },
        "config": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "EC2_INSTANCE" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/ec2" } } } },
        { "if": { "properties": { "type": { "const": "ECR_REPOSITORY" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/ecr" } } } },
        { "if": { "properties": { "type": { "const": "S3_BUCKET" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/s3" } } } },
        { "if": { "properties": { "type": { "const": "IAM_ROLE" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/iam" } } } },
        { "if": { "properties": { "type": { "const": "LAMBDA_FUNCTION" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/lambda" } } } },
        { "if": { "properties": { "type": { "const": "DYNAMODB_TABLE" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/dynamodb" } } } },
        { "if": { "properties": { "type": { "const": "SQS_QUEUE" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/sqs" } } } },
        { "if": { "properties": { "type": { "const": "SNS_TOPIC" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/sns" } } } }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceNodeId", "targetNodeId"],
      "properties": {
        "sourceNodeId": { "type": "string", "minLength": 1 },
        "targetNodeId": { "type": "string", "minLength": 1 },
        "sourceHandle": { "type": ["string", "null"] },
        "targetHandle": { "type": ["string", "null"] }
      }
    },
    "ec2": { "type": "object", "additionalProperties": false, "required": ["imageId"], "properties": { "imageId": { "type": "string", "minLength": 1 }, "instanceType": { "type": "string" }, "instanceCount": { "type": "integer", "minimum": 1 }, "keyName": { "type": "string" }, "securityGroupIds": { "type": "array", "items": { "type": "string" } }, "subnetId": { "type": "string" }, "iamInstanceProfile": { "type": "string" }, "name": { "type": "string" }, "userData": { "type": "string" }, "monitoring": { "type": "boolean" }, "ebsOptimized": { "type": "boolean" }, "disableApiTermination": { "type": "boolean" }, "shutdownBehavior": { "enum": ["stop", "terminate"] }, "metadataHttpTokens": { "enum": ["optional", "required"] }, "dryRun": { "type": "boolean" } } },
    "ecr": { "type": "object", "additionalProperties": false, "required": ["repositoryName"], "properties": { "repositoryName": { "type": "string", "minLength": 1 }, "imageTagMutability": { "enum": ["MUTABLE", "IMMUTABLE"] }, "scanOnPush": { "type": "boolean" } } },
    "s3": { "type": "object", "additionalProperties": false, "required": ["bucketName"], "properties": { "bucketName": { "type": "string", "minLength": 1 } } },
    "iam": { "type": "object", "additionalProperties": false, "required": ["roleName"], "anyOf": [{ "required": ["trustedService"] }, { "required": ["assumeRolePolicyDocument"] }], "properties": { "roleName": { "type": "string", "minLength": 1 }, "trustedService": { "enum": ["ec2.amazonaws.com", "lambda.amazonaws.com", "ecs-tasks.amazonaws.com"] }, "assumeRolePolicyDocument": { "type": "string", "minLength": 1 }, "managedPolicyArns": { "type": "array", "items": { "type": "string", "minLength": 20 } }, "description": { "type": "string" }, "path": { "type": "string" }, "maxSessionDuration": { "type": "integer", "minimum": 3600, "maximum": 43200 }, "permissionsBoundaryArn": { "type": "string", "minLength": 20 } } },
    "lambda": { "type": "object", "additionalProperties": false, "required": ["functionName", "roleArn", "handler", "runtime", "codeZipBase64"], "properties": { "functionName": { "type": "string", "minLength": 1 }, "roleArn": { "type": "string", "minLength": 1 }, "handler": { "type": "string", "minLength": 1 }, "runtime": { "type": "string", "minLength": 1 }, "codeZipBase64": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "memorySize": { "type": "integer", "minimum": 128 }, "timeout": { "type": "integer", "minimum": 1 } } },
    "dynamodb": { "type": "object", "additionalProperties": false, "required": ["tableName", "keySchema", "attributeDefinitions"], "properties": { "tableName": { "type": "string", "minLength": 1 }, "keySchema": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/keySchema" } }, "attributeDefinitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attributeDefinition" } }, "billingMode": { "enum": ["PAY_PER_REQUEST", "PROVISIONED"] }, "readCapacityUnits": { "type": "integer", "minimum": 1 }, "writeCapacityUnits": { "type": "integer", "minimum": 1 } } },
    "keySchema": { "type": "object", "additionalProperties": false, "required": ["AttributeName", "KeyType"], "properties": { "AttributeName": { "type": "string", "minLength": 1 }, "KeyType": { "enum": ["HASH", "RANGE"] } } },
    "attributeDefinition": { "type": "object", "additionalProperties": false, "required": ["AttributeName", "AttributeType"], "properties": { "AttributeName": { "type": "string", "minLength": 1 }, "AttributeType": { "enum": ["S", "N", "B"] } } },
    "sqs": { "type": "object", "additionalProperties": false, "required": ["queueName"], "properties": { "queueName": { "type": "string", "minLength": 1 }, "visibilityTimeoutSeconds": { "type": "integer", "minimum": 0 }, "messageRetentionPeriodSeconds": { "type": "integer", "minimum": 60 } } },
    "sns": { "type": "object", "additionalProperties": false, "required": ["topicName"], "properties": { "topicName": { "type": "string", "minLength": 1 }, "fifoTopic": { "type": "boolean" } } }
  }
}
