# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS build

WORKDIR /app/contracts
COPY contracts/ ./
RUN npm ci --ignore-scripts && npm run build

WORKDIR /app/client
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./
# Next.js embeds NEXT_PUBLIC_* values at build time; never copy the env file into a layer.
RUN --mount=type=secret,id=client_env,target=/app/client/.env npm run build
RUN npm prune --omit=dev --ignore-scripts \
    && npm prune --prefix /app/contracts --omit=dev --ignore-scripts

FROM node:24-bookworm-slim AS runtime
WORKDIR /app/client
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build /app/contracts /app/contracts
COPY --from=build /app/client/package.json ./package.json
COPY --from=build /app/client/node_modules ./node_modules
COPY --from=build /app/client/next.config.ts ./next.config.ts
COPY --from=build /app/client/public ./public
COPY --from=build /app/client/.next ./.next
EXPOSE 3000
CMD ["npm", "run", "start"]
