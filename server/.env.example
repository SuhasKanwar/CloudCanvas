PORT=9000
NODE_ENV=development
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://postgres:dev@localhost:5432/cloudcanvas
MICROSERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=generate_one_value_and_set_it_in_both_server_and_service_env_files
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
AWS_REGION=ap-south-1
# Changing this requires re-encrypting every stored AWS connection first.
AWS_ENCRYPTION_KEY=replace_with_a_random_secret_at_least_32_characters_long
AWS_RESOURCE_STATUS_REFRESH_CONCURRENCY=4
AWS_DEPLOYMENT_STALE_AFTER_MS=21600000
AWS_DEPENDENCY_READY_TIMEOUT_MS=90000
AWS_DEPENDENCY_READY_INTERVAL_MS=3000
FRONTEND_URL=http://localhost:3000
